# ==============================================================================
# FARMÁCIAS ASSOCIADAS - ENVIRONMENT CONFIGURATION (TEMPLATE)
# 
# NOTA DE SEGURANÇA:
# NUNCA commite arquivos .env com chaves secretas ou credenciais de produção.
# Configure as variáveis de produção DIRETAMENTE no painel da Vercel:
# Settings > Environment Variables
# ==============================================================================

# Supabase Configuration (Configurado via Vercel)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key
SUPABASE_PROJECT_ID=your-project-id

# Client-Side Supabase (Injetado em tempo de build pela Vercel)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Environment mode
NODE_ENV=production

# ==============================================================================
# DISTANCE / LOGISTICS APIS
# ==============================================================================

# OpenRouteService — Cálculo de distância por estrada (free tier)
# Obtenha sua chave em: https://openrouteservice.org/dev/#/api-docs
# Esta chave é pública (Basic Key) e pode ser usada no frontend com segurança.
VITE_ORS_API_KEY=your-openrouteservice-basic-key
