# ==============================================================================
# FARMÁCIAS ASSOCIADAS - ENVIRONMENT CONFIGURATION (TEMPLATE)
# 
# NOTA DE SEGURANÇA:
# NUNCA commite arquivos .env com chaves secretas ou credenciais de produção.
# Configure as variáveis de produção DIRETAMENTE no painel da Vercel:
# Settings > Environment Variables
#
# NENHUMA CHAVE DE ACESSO OU SEGREDO PODE TER PREFIXO VITE_ OU NEXT_PUBLIC_
# ==============================================================================

# Supabase Client-Side (Chave pública / anônima)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# ==============================================================================
# SERVER-SIDE ONLY VARIABLES (VERCEL ENVIRONMENT VARIABLES)
# PROIBIDO USAR PREFIXO VITE_ OU NEXT_PUBLIC_ NESTAS VARIÁVEIS!
# ==============================================================================

# Supabase Service Role Key (Acesso privilegiado restrito às Serverless Functions/API)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Fallback Seguro para Admin (Utilizado apenas se tabela profiles/auth estiver vazia)
ADMIN_FALLBACK_EMAIL=admin@farmaciasassociadas.com.br
ADMIN_FALLBACK_PASSWORD=your-ultra-secure-random-admin-password

# Gateway Asaas - Token de Verificação de Assinatura de Webhook
ASAAS_WEBHOOK_TOKEN=your-asaas-webhook-secret-token

# Ambiente
NODE_ENV=production

# ==============================================================================
# DISTANCE / LOGISTICS APIS (Opcional - Fallback automático para Haversine)
# ==============================================================================
VITE_ORS_API_KEY=

